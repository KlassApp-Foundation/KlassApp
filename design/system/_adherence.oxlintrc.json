{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/core/**",
              "components/data-display/**",
              "components/forms/**",
              "components/surfaces/**",
              "concepts/admin-mvp/**",
              "concepts/quickstart/**",
              "klassapp-handoff-2026-09-29-docs/design-system/concepts/quickstart/**",
              "klassapp-handoff-2026-09-29-docs/design-system/templates/pitch-deck/**",
              "klassapp-handoff-2026-10-01-documents/template/**",
              "klassapp-handoff-2026-10-08-admin-mvp/concept/**",
              "ui_kits/onboarding-wizard/**",
              "ui_kits/school-dashboard/**",
              "ui_kits/toshi-assistant/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Sora, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|className|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pending|approved|rejected|paid|unpaid|active|inactive|warning|info)$/]",
        "message": "<Badge> variant must be one of 'pending' | 'approved' | 'rejected' | 'paid' | 'unpaid' | 'active' | 'inactive' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|type|disabled|loading|v2|className|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, type, disabled, loading, v2, className, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:warning|primary|success|danger|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'warning' | 'primary' | 'success' | 'danger' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|shadow|hover|title|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, shadow, hover, title, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|lg|default|none)$/]",
        "message": "<Card> padding must be one of 'sm' | 'lg' | 'default' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='shadow'] > Literal[value!=/^(?:sm|md|lg|none)$/]",
        "message": "<Card> shadow must be one of 'sm' | 'md' | 'lg' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|value|type|checked|defaultChecked|disabled|className|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, name, value, type, checked, defaultChecked, disabled, className, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:checkbox|radio)$/]",
        "message": "<Checkbox> type must be one of 'checkbox' | 'radio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|value|error|required|placeholder|help|options|className|onChange|children|key|ref|className|style|children)$/]",
        "message": "<FormGroup> doesn't accept that prop. Declared props: label, name, type, value, error, required, placeholder, help, options, className, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormGroup'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:number|text|email|select|textarea|date)$/]",
        "message": "<FormGroup> type must be one of 'number' | 'text' | 'email' | 'select' | 'textarea' | 'date'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoogleDriveMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:decorative|className|style|key|ref|className|style|children)$/]",
        "message": "<GoogleDriveMark> doesn't accept that prop. Declared props: decorative, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|color|link|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: icon, value, label, color, link."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|green|amber|red|purple)$/]",
        "message": "<KpiCard> color must be one of 'blue' | 'green' | 'amber' | 'red' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlackMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:decorative|className|style|key|ref|className|style|children)$/]",
        "message": "<SlackMark> doesn't accept that prop. Declared props: decorative, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:headers|striped|hover|density|selectable|sortable|cardMobile|className|children|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: headers, striped, hover, density, selectable, sortable, cardMobile, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:comfortable|compact)$/]",
        "message": "<Table> density must be one of 'comfortable' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:decorative|className|style|key|ref|className|style|children)$/]",
        "message": "<WhatsAppMark> doesn't accept that prop. Declared props: decorative, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
