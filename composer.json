{
    "name": "laravel/laravel",
    "description": "An open education protocol for humans and agents. KlassApp is an education protocol that runs in the tools educationists already use. Admins manage school operations in Slack, teachers enter marks from spreadsheets, and parents receive their children's school updates on WhatsApp, all by chatting in natural language with Toshi, your school's AI assistant.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/toshi-ui"
        }
    ],
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php-laravel": "^3.11",
        "bacon/bacon-qr-code": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/tables": "^3.3",
        "flowframe/laravel-trend": "^0.5.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "iio/libmergepdf": "^4.0",
        "jantinnerezo/livewire-alert": "^3.0",
        "klassapp/toshi-ui": "*",
        "kreait/laravel-firebase": "^7.0",
        "laracasts/presenter": "^0.2.9",
        "laravel/ai": "^0.10",
        "laravel/framework": "^12.0",
        "laravel/mcp": "^0.8",
        "laravel/nightwatch": "^1.30",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.6",
        "league/csv": "^9.14",
        "league/flysystem-aws-s3-v3": "^3.24.0",
        "livewire/livewire": "^3.4",
        "maatwebsite/excel": "3.1.x-dev",
        "mallardduck/blade-lucide-icons": "^2.0",
        "nckg/laravel-impersonate": "4.0.1",
        "phpoffice/phpword": "^1.4",
        "predis/predis": "^3.7",
        "pusher/pusher-php-server": "^7.3",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-model-states": "^2.11.3",
        "stevebauman/purify": "^6.0",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "symfony/postmark-mailer": "^7.0",
        "symfony/process": "^7.0.3",
        "twilio/sdk": "^8.13",
        "wire-elements/spotlight": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/boost": "*",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-web-tinker": "^1.8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "config/school-plus.php",
            "app/Helpers/SiteHelper.php",
            "app/Helpers/activity.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
