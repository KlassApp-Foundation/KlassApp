{
  "name": "laravel/laravel",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.1",
    "algolia/algoliasearch-client-php": "3.4.1",
    "aws/aws-sdk-php-laravel": "dev-master",
    "barryvdh/laravel-dompdf": "dev-master",
