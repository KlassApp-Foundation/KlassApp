{
    "name": "klassapp/toshi-ui",
    "description": "Reusable Toshi AI assistant UI components — suggestion chips row and tool confirmation card. Presentation only, no business logic.",
    "type": "library",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "KlassApp\\ToshiUi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KlassApp\\ToshiUi\\ToshiUiServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "minimum-stability": "stable"
}
