{
  "name": "whatsapp-embed-trigger",
  "nodes": [
    {
      "id": "webhook-laravel-knowledge",
      "name": "Laravel Knowledge Update Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-embed-trigger",
        "responseMode": "responseNode",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "webhookId": "whatsapp-embed-trigger"
    },
    {
      "id": "extract-knowledge",
      "name": "Extract Knowledge Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "k1", "name": "school_id", "type": "number", "value": "={{ $json.school_id }}" },
            { "id": "k2", "name": "category", "type": "string", "value": "={{ $json.category }}" },
            { "id": "k3", "name": "content", "type": "string", "value": "={{ $json.content }}" },
            { "id": "k4", "name": "academic_year", "type": "string", "value": "={{ $json.academic_year ?? '' }}" },
            { "id": "k5", "name": "action", "type": "string", "value": "={{ $json.action ?? 'upsert' }}" },
            { "id": "k6", "name": "record_id", "type": "number", "value": "={{ $json.record_id ?? 0 }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "check-action",
      "name": "Upsert or Delete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.action }}",
              "rightValue": "delete",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "delete-document",
      "name": "Delete from Flowise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 560],
      "parameters": {
        "method": "DELETE",
        "url": "={{ $env.FLOWISE_URL }}/api/v1/document/upsert/{{ $env.FLOWISE_CHATFLOW_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.FLOWISE_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "metadata",
              "type": "jsonValue",
              "value": "={ \"record_id\": {{ $json.record_id }}, \"school_id\": {{ $json.school_id }} }"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "upsert-document",
      "name": "Upsert to Flowise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 240],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWISE_URL }}/api/v1/document/upsert/{{ $env.FLOWISE_CHATFLOW_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.FLOWISE_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "metadata",
              "type": "jsonValue",
              "value": "={ \"school_id\": {{ $json.school_id }}, \"category\": \"{{ $json.category }}\", \"academic_year\": \"{{ $json.academic_year }}\", \"record_id\": {{ $json.record_id }} }"
            },
            { "name": "content", "value": "={{ $json.content }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [1120, 400],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"action\": \"{{ $json.action }}\", \"record_id\": {{ $json.record_id }} }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "sticky-embed",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 320],
      "parameters": {
        "color": 3,
        "width": 520,
        "height": 160,
        "content": "## 1. Knowledge Update Trigger\nLaravel fires webhook when school admin creates/edits an event, announcement, or policy"
      }
    },
    {
      "id": "sticky-upsert",
      "name": "Sticky Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 160],
      "parameters": {
        "color": 4,
        "width": 400,
        "height": 200,
        "content": "## 2. Upsert Flow\nContent + metadata → Flowise handles chunking, embedding (MiniLM-L6), pgvector upsert"
      }
    },
    {
      "id": "sticky-delete",
      "name": "Sticky Note 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 480],
      "parameters": {
        "color": 5,
        "width": 400,
        "height": 200,
        "content": "## 3. Delete Flow\nRemove document by record_id metadata from pgvector"
      }
    }
  ],
  "connections": {
    "Laravel Knowledge Update Webhook": {
      "main": [
        [{ "node": "Extract Knowledge Payload", "type": "main", "index": 0 }]
      ]
    },
    "Extract Knowledge Payload": {
      "main": [
        [{ "node": "Upsert or Delete?", "type": "main", "index": 0 }]
      ]
    },
    "Upsert or Delete?": {
      "main": [
        [{ "node": "Delete from Flowise", "type": "main", "index": 0 }],
        [{ "node": "Upsert to Flowise", "type": "main", "index": 0 }]
      ]
    },
    "Delete from Flowise": {
      "main": [
        [{ "node": "Respond 200 OK", "type": "main", "index": 0 }]
      ]
    },
    "Upsert to Flowise": {
      "main": [
        [{ "node": "Respond 200 OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": []
}
