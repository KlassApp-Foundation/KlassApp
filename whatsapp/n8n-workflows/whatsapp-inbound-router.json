      "name": "Flowise RAG Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2000, 1040],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWISE_URL }}/api/v1/prediction/{{ $env.FLOWISE_CHATFLOW_ID }}",
        "sendHeaders": true,
        "headerParameters": {
