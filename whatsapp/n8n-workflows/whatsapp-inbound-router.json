    {
      "id": "format-events",
      "name": "Format Events Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 840],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prev = $input.first().json;\nconst events = (prev.events || []).slice(0, 5);\n\nif (!events.length) {\n  return [{ json: { ...prev, responseText: '📅 No upcoming events at the moment.' } }];\n}\n\nlet text = `📅 *Upcoming Events*\\n\\n`;\nevents.forEach((e, i) => {\n  text += `*${i + 1}. ${e.title}*\\n📆 ${e.start_date}`;\n  if (e.end_date && e.end_date !== e.start_date) text += ` — ${e.end_date}`;\n  text += `\\n🕐 ${e.time}\\n📍 ${e.venue}\\n\\n`;\n});\n\nreturn [{ json: { ...prev, responseText: text.trim() } }];"
      }
    },
