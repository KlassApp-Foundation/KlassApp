    {
      "id": "normalise-phone",
      "name": "Normalise Phone to E.164",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.phone || '';\nlet digits = raw.replace(/\\D/g, '');\nif (digits.startsWith('0')) digits = '256' + digits.slice(1);\nif (!digits.startsWith('256')) digits = '256' + digits;\nconst normalised = '+' + digits;\n\nreturn [{ json: { ...$input.first().json, phone: normalised } }];"
      }
    },
    {
      "id": "generate-hmac",
      "name": "Generate HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst prev = $input.first().json;\nconst timestamp = Date.now().toString();\nconst body = JSON.stringify({ phone: prev.phone });\nconst payload = timestamp + '.' + body;\nconst secret = process.env.WHATSAPP_HMAC_SECRET;\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn [{ json: { ...prev, hmacTimestamp: timestamp, hmacSignature: signature, identifyBody: body } }];"
      }
    },
    {
