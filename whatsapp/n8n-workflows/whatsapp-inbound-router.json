      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2000, 240],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LARAVEL_API_URL }}/api/whatsapp/student/{{ $json.children[0].student_id }}/grades?term=current",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-WhatsApp-Signature", "value": "={{ $json.hmacSignature ?? '' }}" },
            { "name": "X-WhatsApp-Timestamp", "value": "={{ $json.hmacTimestamp ?? Date.now().toString() }}" }
          ]
        },
        "options": { "allowResponseErrors": true }
      }
    },
    {
      "id": "format-grades",
      "name": "Format Grades Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prev = $input.first().json;\nconst grades = prev.exams || [];\nconst studentName = prev.student_name || 'Student';\nconst className = prev.class || 'N/A';\n\nif (!grades.length || prev.message) {\n  return [{ json: { ...prev, responseText: prev.message || 'No results available yet for ' + studentName + '.' } }];\n}\n\nlet text = `📊 *${studentName} — ${className}*\\n\\n`;\ngrades.forEach(exam => {\n  text += `*${exam.exam_name}*\\n`;\n  exam.marks.forEach(m => {\n    text += `${m.subject}: ${m.score}% (${m.grade})\\n`;\n  });\n  text += `Overall: ${exam.average}% | Position: ${exam.position}\\n\\n`;\n});\n\nreturn [{ json: { ...prev, responseText: text.trim() } }];"
      }
    },
