    {
      "id": "format-attendance",
      "name": "Format Attendance Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 640],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prev = $input.first().json;\nconst studentName = prev.student_name || 'Student';\n\nlet text = `📅 *${studentName}'s Attendance*\\nPresent: ${prev.present} days\\nAbsent: ${prev.absent} days\\nLate: ${prev.late} days\\nRate: ${prev.attendance_rate}\\n\\nThis term`;\n\nif (prev.recent_absences && prev.recent_absences.length) {\n  text += `\\n\\nRecent absences:\\n`;\n  prev.recent_absences.forEach(a => {\n    text += `• ${a.date}: ${a.status}\\n`;\n  });\n}\n\nreturn [{ json: { ...prev, responseText: text } }];"
      }
    },
