    {
      "id": "format-fees",
      "name": "Format Fees Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 440],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prev = $input.first().json;\nconst studentName = prev.student_name || 'Student';\nconst totalFees = prev.total_fees || '0';\nconst currency = prev.currency || 'UGX';\n\nlet text = `💰 *${studentName}'s Fee Balance*\\nOwed: ${currency} ${totalFees}\\n\\n`;\nif (prev.fee_breakdown && prev.fee_breakdown.length) {\n  prev.fee_breakdown.forEach(f => {\n    text += `• ${f.name}: ${currency} ${f.amount}\\n`;\n  });\n}\ntext += `\\nReply PAY for payment options`;\n\nreturn [{ json: { ...prev, responseText: text } }];"
      }
    },
