      "name": "Fetch Events (Laravel API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2000, 840],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LARAVEL_API_URL }}/api/whatsapp/school/{{ $json.school_id }}/events?upcoming=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
