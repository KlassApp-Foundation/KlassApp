{
  "name": "whatsapp-outbound-notifier",
  "nodes": [
    {
      "id": "webhook-laravel",
      "name": "Laravel Outbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-outbound",
        "responseMode": "responseNode",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "webhookId": "whatsapp-outbound-notifier"
    },
    {
      "id": "extract-payload",
      "name": "Extract Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "phone", "type": "string", "value": "={{ $json.phone }}" },
            { "id": "p2", "name": "msgType", "type": "string", "value": "={{ $json.type }}" },
            { "id": "p3", "name": "message", "type": "string", "value": "={{ $json.message ?? '' }}" },
            { "id": "p4", "name": "templateName", "type": "string", "value": "={{ $json.template_name ?? '' }}" },
            { "id": "p5", "name": "templateParams", "type": "array", "value": "={{ $json.template_params ?? [] }}" },
            { "id": "p6", "name": "studentName", "type": "string", "value": "={{ $json.student_name ?? '' }}" },
            { "id": "p7", "name": "schoolId", "type": "number", "value": "={{ $json.school_id ?? 0 }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "check-type",
      "name": "Text or Template?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "t1",
              "leftValue": "={{ $json.msgType }}",
              "rightValue": "text",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "generate-hmac-text",
      "name": "Generate HMAC (Text)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst prev = $input.first().json;\nconst timestamp = Date.now().toString();\nconst body = JSON.stringify({ phone: prev.phone });\nconst payload = timestamp + '.' + body;\nconst secret = process.env.WHATSAPP_HMAC_SECRET;\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn [{ json: { ...prev, hmacTimestamp: timestamp, hmacSignature: signature } }];"
      }
    },
    {
      "id": "check-window",
      "name": "Check 24hr Window (Laravel API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1340, 240],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LARAVEL_API_URL }}/api/whatsapp/check-window?phone={{ $json.phone }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-WhatsApp-Signature", "value": "={{ $json.hmacSignature }}" },
            { "name": "X-WhatsApp-Timestamp", "value": "={{ $json.hmacTimestamp }}" }
          ]
        },
        "options": { "allowResponseErrors": true }
      }
    },
    {
      "id": "generate-hmac-get",
      "name": "Generate HMAC (GET)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst prev = $input.first().json;\nconst timestamp = Date.now().toString();\nconst payload = timestamp + '.';\nconst secret = process.env.WHATSAPP_HMAC_SECRET;\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn [{ json: { ...prev, hmacTimestamp: timestamp, hmacSignature: signature } }];"
      }
    },
    {
      "id": "check-window-result",
      "name": "Window Open?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1340, 240],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "w1",
              "leftValue": "={{ $json.window_open }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send-free-text",
      "name": "Send Free-Form Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1560, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $('Extract Payload').first().json.phone.replace('+', '') }}" },
            { "name": "text", "value": "={{ $('Extract Payload').first().json.message }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "send-as-template",
      "name": "Send as Utility Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1560, 360],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/template/send/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $('Extract Payload').first().json.phone.replace('+', '') }}" },
            { "name": "name", "value": "={{ $('Extract Payload').first().json.templateName || 'fee_reminder' }}" },
            { "name": "language", "value": "={{ $env.WHATSAPP_TEMPLATE_LANGUAGE || 'en' }}" },
            {
              "name": "components",
              "type": "jsonValue",
              "value": "=[{ \"type\": \"body\", \"parameters\": {{ JSON.stringify($('Extract Payload').first().json.templateParams.map(p => ({ type: 'text', text: p }))) } }]"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "send-template-direct",
      "name": "Send Template (Direct)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 560],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/template/send/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $('Extract Payload').first().json.phone.replace('+', '') }}" },
            { "name": "name", "value": "={{ $json.templateName }}" },
            { "name": "language", "value": "={{ $env.WHATSAPP_TEMPLATE_LANGUAGE || 'en' }}" },
            {
              "name": "components",
              "type": "jsonValue",
              "value": "=[{ \"type\": \"body\", \"parameters\": {{ JSON.stringify($json.templateParams.map(p => ({ type: 'text', text: p }))) } }]"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "report-delivery",
      "name": "Report to Laravel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1780, 240],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LARAVEL_API_URL }}/api/whatsapp/delivery-webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-WhatsApp-Signature", "value": "={{ $json.hmacSignature ?? '' }}" },
            { "name": "X-WhatsApp-Timestamp", "value": "={{ $json.hmacTimestamp ?? Date.now().toString() }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "whatsapp_message_id", "value": "={{ $('Send Free-Form Text').first().json.key?.id ?? $('Send as Utility Template').first().json.key?.id ?? $('Send Template (Direct)').first().json.key?.id ?? '' }}" },
            { "name": "phone", "value": "={{ $('Extract Payload').first().json.phone }}" },
            { "name": "template_name", "value": "={{ $('Extract Payload').first().json.templateName ?? '' }}" },
            { "name": "status", "value": "sent" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [2000, 240],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"message\": \"Outbound message processed\" }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "sticky-outbound",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 320],
      "parameters": {
        "color": 3,
        "width": 1300,
        "height": 160,
        "content": "## 1. Inbound from Laravel\nLaravel POSTs outbound message request → extract payload → route by type"
      }
    },
    {
      "id": "sticky-text-flow",
      "name": "Sticky Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 40],
      "parameters": {
        "color": 4,
        "width": 840,
        "height": 480,
        "content": "## 2. Text Message Flow\nCheck 24hr window → if open: free-form text (free) → if closed: convert to utility template (charged)"
      }
    },
    {
      "id": "sticky-template",
      "name": "Sticky Note 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 480],
      "parameters": {
        "color": 5,
        "width": 400,
        "height": 200,
        "content": "## 3. Template Message Flow\nDirect template send — no window check needed"
      }
    }
  ],
  "connections": {
    "Laravel Outbound Webhook": {
      "main": [
        [{ "node": "Extract Payload", "type": "main", "index": 0 }]
      ]
    },
    "Extract Payload": {
      "main": [
        [{ "node": "Text or Template?", "type": "main", "index": 0 }]
      ]
    },
    "Text or Template?": {
      "main": [
        [{ "node": "Generate HMAC (Text)", "type": "main", "index": 0 }],
        [{ "node": "Send Template (Direct)", "type": "main", "index": 0 }]
      ]
    },
    "Generate HMAC (Text)": {
      "main": [
        [{ "node": "Generate HMAC (GET)", "type": "main", "index": 0 }]
      ]
    },
    "Generate HMAC (GET)": {
      "main": [
        [{ "node": "Check 24hr Window (Laravel API)", "type": "main", "index": 0 }]
      ]
    },
    "Check 24hr Window (Laravel API)": {
      "main": [
        [{ "node": "Window Open?", "type": "main", "index": 0 }]
      ]
    },
    "Window Open?": {
      "main": [
        [{ "node": "Send Free-Form Text", "type": "main", "index": 0 }],
        [{ "node": "Send as Utility Template", "type": "main", "index": 0 }]
      ]
    },
    "Send Free-Form Text": {
      "main": [
        [{ "node": "Report to Laravel", "type": "main", "index": 0 }]
      ]
    },
    "Send as Utility Template": {
      "main": [
        [{ "node": "Report to Laravel", "type": "main", "index": 0 }]
      ]
    },
    "Send Template (Direct)": {
      "main": [
        [{ "node": "Report to Laravel", "type": "main", "index": 0 }]
      ]
    },
    "Report to Laravel": {
      "main": [
        [{ "node": "Respond 200 OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": []
}
