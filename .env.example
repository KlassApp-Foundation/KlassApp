APP_NAME=KlassApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ROBOTS_NOINDEX=false

# ISO-8601 UTC instant from which unverified emails gate password sign-ins.
# Blank keeps the built-in default (2026-10-05). Must not be set in production for now.
EMAIL_VERIFICATION_CUTOFF=

LOG_CHANNEL=stack
LOG_STACK=daily

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0
DEBUGBAR_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klassapp_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SCHEME=tcp

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

FILESYSTEM_DISK=local

# === Push Notifications (Firebase Cloud Messaging) ===
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_TEACHER_SERVER_KEY=
FCM_TEACHER_SENDER_ID=
FIREBASE_CREDENTIALS=
TEACHER_FIREBASE_CREDENTIALS=

# === WhatsApp Business Cloud API (Meta) ===
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_WABA_ID=
WHATSAPP_BUSINESS_VERIFY_TOKEN=klassapp_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_SIGNATURE=true
WHATSAPP_BUSINESS_API_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_BUSINESS_NAME=KlassApp
WHATSAPP_HMAC_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en

# === Toshi LLM Assistant (OpenAI-compatible) ===
# Prefer OPENAI_COMPATIBLE_*; TOSHI_LLM_* remain legacy aliases. Never commit real keys.
OPENAI_COMPATIBLE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-chat
# Optional: models used when the primary fails / for escalated queries.
# Leave empty to disable fallback behaviour (recommended — no provider has every model).
OPENAI_COMPATIBLE_FALLBACK_MODEL=
TOSHI_FALLBACK_MODEL=
TOSHI_ESCALATED_MODEL=
# New schools: preview (Coming soon, no setup guide) or onboarding (scripted guide). Never assistant.
TOSHI_DEFAULT_MODE=preview
TOSHI_LLM_ENABLED=false
TOSHI_LLM_BASE_URL=https://api.openai.com/v1
TOSHI_LLM_API_KEY=
TOSHI_LLM_MODEL=gpt-4o-mini
TOSHI_DAILY_LLM_LIMIT=100
# Keep false until staging Admin/Teacher free-form LLM asks are verified with a funded key.
TOSHI_SDK_V2_ENABLED=false
TOSHI_PLATFORM_GATE_ENABLED=false
TOSHI_PLATFORM_USER_IDS=

# === SMS Gateway (MSG91) ===
SMS_GATEWAY=MSG91
SMS_STATUS=off
REMINDER_API_KEY=
REMINDER_SENDER_ID=
REMINDER_ROUTE_NO=

# === Algolia Search ===
SCOUT_QUEUE=true
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

# === Google Maps / Places (browser key; restrict by HTTP referrer in GCP) ===
GOOGLE_MAPS_API_KEY=

# === Google OAuth (sign-in and school connectors). Empty until a Cloud client exists. ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# School connector callback. Locally: http://localhost/admin/settings/google/callback
# Sign-in keeps APP_URL/auth/google/callback. Do not point this at the sign-in URL.
GOOGLE_CONNECTOR_REDIRECT_URI=

# === Google reCAPTCHA ===
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# === Twilio (SMS/Voice) ===
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=

# === Timezone & Cache ===
TIMEZONE=Africa/Kampala
CACHE_TIME=8400
SNOOZE_TIME=600
ADDON_API_URL=

# === Demo requests (lead capture; non-secret) ===
LEADS_EMAIL=
DEMO_BOOKING_URL=

# === Demo marks release webhook (optional; for a presenter's n8n workflow) ===
# Only demo schools post it; the body carries the exam and each student's code
# and class, signed with HMAC-SHA256 (X-KlassApp-Signature: sha256=<hex>).
DEMO_RELEASE_WEBHOOK_URL=
DEMO_RELEASE_WEBHOOK_SECRET=

# === Seeded admin accounts (optional; safe placeholders used when unset) ===
# SITE_OWNER_EMAIL=
# SITE_OWNER_MOBILE_NO=
# SUPERADMIN_MOBILE_NO=
# TEAM_ADMIN_EMAIL=
# TEAM_ADMIN_MOBILE_NO=

# === Backup alerts (optional; WhatsApp recipient in E.164) ===
# BACKUP_WHATSAPP_PHONE=

# Launch: self-serve sign-up (false shows the early access page at /register)
SIGNUP_ENABLED=true
PRIVACY_NOTICE_URL=

# HSTS / Referrer / Permissions / report-only CSP headers
SECURITY_HEADERS_ENABLED=true

# === Live demo (one demo school; all off by default) ===
# true: BIND <code> waits for an admin approval on /admin/approvals; the
# DEMO_BIND_TTL_MINUTES clock starts at the approval.
DEMO_BIND_REQUIRES_APPROVAL=
# Loads of /demo per minute per IP (default 60).
DEMO_PAGE_THROTTLE_PER_MINUTE=
# true: outbound WhatsApp goes only to numbers bound to (or pending for) a
# demo school's student, or to the sender being answered. Everything else is
# refused and logged.
WHATSAPP_DEMO_ONLY_RECIPIENTS=
# true: demo:nightly-reset runs at 03:00 Africa/Kampala and restores every
# provisioned demo school to its starting state.
DEMO_NIGHTLY_RESET_ENABLED=
# Read by demo:provision when no password argument is given (set it only for
# the provisioning run, then remove it). Never commit a value.
DEMO_PROVISION_ADMIN_PASSWORD=
