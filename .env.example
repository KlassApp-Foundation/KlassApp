APP_NAME=KlassApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=daily
DEBUGBAR_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klassapp_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

FILESYSTEM_DRIVER=s3

# === Push Notifications (Firebase Cloud Messaging) ===
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_TEACHER_SERVER_KEY=
FCM_TEACHER_SENDER_ID=
FIREBASE_CREDENTIALS=
TEACHER_FIREBASE_CREDENTIALS=

# === WhatsApp Business Cloud API (Meta) ===
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_WABA_ID=
WHATSAPP_BUSINESS_VERIFY_TOKEN=klassapp_verify_2026
WHATSAPP_BUSINESS_API_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_BUSINESS_NAME=KlassApp
WHATSAPP_HMAC_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en

# === Toshi LLM Assistant ===
TOSHI_LLM_ENABLED=false
TOSHI_LLM_BASE_URL=https://api.openai.com/v1
TOSHI_LLM_API_KEY=
TOSHI_LLM_MODEL=gpt-4o-mini
TOSHI_DAILY_LLM_LIMIT=100

# === SMS Gateway (MSG91) ===
SMS_GATEWAY=MSG91
SMS_STATUS=off
REMINDER_API_KEY=
REMINDER_SENDER_ID=
